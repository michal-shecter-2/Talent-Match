# Copy to .env and fill these values locally. Never send passwords in chat or commit .env.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Talent
DB_USER=talent_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
TRUST_PROXY_HOPS=0
REGISTRATION_ENABLED=true

# A self-signed LOCAL SQL instance may require DB_TRUST_SERVER_CERTIFICATE=true.
# Production requires HTTPS, encryption and a trusted SQL server certificate.
